generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CLIENT
  EDITOR
  SUPER_ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  PUBLISHED
  PARTIAL_FAILED
  FAILED
  CANCELLED
}

enum SocialPlatform {
  META_FACEBOOK
  META_INSTAGRAM
  LINKEDIN
  TWITTER_X
  YOUTUBE
  REDDIT
  GLASSDOOR
}

enum ShowcaseCategory {
  SAAS
  ENTERPRISE_WEB
  ECOMMERCE
  AI_AUTOMATION
  MOBILE
  OTHER
}

enum ShowcaseBadge {
  NEW
  BETA
  UPDATED
}

enum LeadSource {
  ESTIMATOR
  QUICK_CALLBACK
  BOOKING
  CONTACT_FORM
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  ARCHIVED
}

enum ContactEventType {
  WHATSAPP_CLICK
  CALL_CLICK
  EMAIL_CLICK
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  REJECTED
  HIRED
}

enum EmailJobStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id             String            @id @default(cuid())
  name           String
  username       String?           @unique
  email          String            @unique
  emailVerified  Boolean           @default(false)
  passwordHash   String?
  avatarUrl      String?
  avatarPublicId String?
  avatarVersion  Int?
  role           Role              @default(USER)
  isActive       Boolean           @default(true)
  lastSignInAt   DateTime?
  sessions       Session[]
  accounts       Account[]
  authEvents     AuthEvent[]
  socialPosts    SocialPost[]
  showcase       ShowcaseProduct[]
  blogPosts      BlogPost[]
  assignedLeads  Lead[]            @relation("AssignedLeads")
  leadNotes      LeadNote[]
  leadActivities LeadStatusChange[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  ip             String?
  userAgent      String?
  approxLocation String?
  rememberMe     Boolean   @default(false)
  lastActiveAt   DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id          String   @id @default(cuid())
  email       String
  otpHash     String
  attempts    Int      @default(0)
  resendCount Int      @default(0)
  lastSentAt  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([email, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuthEvent {
  id        String   @id @default(cuid())
  type      String
  status    String   @default("SUCCESS")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

model ShowcaseProduct {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  tagline          String
  shortDescription String
  fullDescription  String?
  coverImageUrl    String
  coverImageId     String
  coverImageWidth  Int
  coverImageHeight Int
  coverImageAlt    String
  coverBlurDataUrl String?
  galleryImages    Json?
  category         ShowcaseCategory
  techTags         String[]
  liveUrl          String
  caseStudyId      String?
  badge            ShowcaseBadge?
  launchDate       DateTime
  featuredOnHome   Boolean          @default(true)
  displayOrder     Int              @default(0)
  status           ContentStatus    @default(DRAFT)
  publishedAt      DateTime?
  deletedAt        DateTime?
  authorId         String
  author           User             @relation(fields: [authorId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, featuredOnHome, displayOrder, launchDate])
}

model Project {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  summary       String
  category      ShowcaseCategory
  techTags      String[]
  coverImageUrl String
  coverImageId  String
  gallery       Json?
  challenge     String?
  solution      String?
  features      String[]
  metrics       Json?
  liveUrl       String?
  featured      Boolean          @default(false)
  displayOrder  Int              @default(0)
  status        ContentStatus    @default(DRAFT)
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, featured, displayOrder])
}

model Service {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  summary      String
  deliverables String[]
  icon         String
  displayOrder Int           @default(0)
  visible      Boolean       @default(true)
  status       ContentStatus @default(PUBLISHED)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  subtitle       String?
  excerpt        String
  body           String
  coverImageUrl  String?
  category       String        @default("Engineering")
  categorySlug   String        @default("engineering")
  tags           String[]
  seoTitle       String?
  seoDescription String?
  readingMinutes Int           @default(1)
  status         ContentStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  rfcCode        String?
  readCount      Int           @default(0)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  deletedAt      DateTime?
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  authorName     String        @default("DevCore Engineering")
  authorRole     String        @default("Systems Architect")
  authorInitials String        @default("DE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Testimonial {
  id         String            @id @default(cuid())
  role       String?
  authorName String
  company    String?
  quote      String
  avatarUrl  String?
  rating     Int?
  status     TestimonialStatus @default(PENDING)
  featured   Boolean           @default(false)
  deletedAt  DateTime?
  createdAt  DateTime          @default(now())
}

model Job {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  department       String
  location         String           @default("Remote")
  type             String           @default("Full-time")
  workplaceType    String           @default("Remote")
  description      String
  skills           String[]         @default([])
  responsibilities String[]         @default([])
  requirements     String[]         @default([])
  salary           String?
  status           JobStatus        @default(OPEN)
  applications     JobApplication[]
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model JobApplication {
  id             String            @id @default(cuid())
  jobId          String
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name           String
  email          String
  resumePublicId String
  portfolioUrl   String?
  message        String?
  status         ApplicationStatus @default(NEW)
  createdAt      DateTime          @default(now())

  @@index([jobId, status])
}

model MediaAsset {
  id         String   @id @default(cuid())
  publicId   String   @unique
  url        String
  width      Int?
  height     Int?
  bytes      Int
  alt        String?
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
}

model Lead {
  id              String             @id @default(cuid())
  source          LeadSource
  name            String
  email           String?
  phone           String?
  company         String?
  jobTitle        String?
  website         String?
  subject         String?
  services        String[]
  budget          String?
  budgetMin       Int?
  currency        String             @default("USD")
  timeline        String?
  brief           String?
  pageUrl         String?
  referrer        String?
  utm             Json?
  status          LeadStatus         @default(NEW)
  priority        LeadPriority       @default(MEDIUM)
  assignedToId    String?
  assignedTo      User?              @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  archivedAt      DateTime?
  notes           LeadNote[]
  history         LeadStatusChange[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([assignedToId])
  @@index([priority, status])
  @@index([email])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model LeadStatusChange {
  id         String      @id @default(cuid())
  leadId     String
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventType  String      @default("STATUS_CHANGE")
  fromStatus LeadStatus?
  toStatus   LeadStatus
  details    String?
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([toStatus, createdAt])
  @@index([leadId, createdAt])
}

model ContactEvent {
  id        String           @id @default(cuid())
  type      ContactEventType
  pageUrl   String
  createdAt DateTime         @default(now())

  @@index([type, createdAt])
}

model ContactSettings {
  id                     String   @id @default("singleton")
  organizationName       String?  @default("DevCore Solutions")
  whatsappNumber         String
  phone                  String
  publicEmail            String
  notifyEmails           String[]
  address                String?
  timezone               String   @default("Asia/Dhaka")
  businessHours          Json
  bookingUrl             String?
  whatsappMessage        String   @default("Hello DevCore, I would like to discuss a project.")
  callbackPromise        String   @default("We call back within 1 business hour")
  afterHoursPolicy       String   @default("NEXT_BUSINESS_DAY")
  incidentContact        String?
  secureMessagingContact String?
  socialLinks            Json?
  seoDefaults            Json?
  brandAssets            Json?
  updatedById            String?
  updatedAt              DateTime @updatedAt
}

model AboutSettings {
  id               String   @id @default("singleton")
  heroBadge        String   @default("ARCHITECTURAL DOSSIER")
  heroTitle        String   @default("Building the Digital Core for a Smarter Tomorrow")
  heroSubtitle     String
  foundingTag      String   @default("FOUNDED 2019 • DISTRIBUTED CORE")
  visionTitle      String   @default("Our Vision")
  visionText       String
  missionTitle     String   @default("Our Mission")
  missionText      String
  philosophyTitle  String   @default("The Core Philosophy")
  philosophyText   String
  philosophyStats  Json
  ctaTitle         String
  ctaSubtitle      String
  ctaPrimaryText   String
  ctaPrimaryUrl    String
  ctaSecondaryText String
  ctaSecondaryUrl  String
  locationEnabled  Boolean  @default(true)
  locationName     String
  locationAddress  String
  locationTimezone String   @default("Asia/Dhaka")
  locationStatus   String   @default("ONLINE • UTC+6")
  updatedAt        DateTime @updatedAt
}

model EngineeringPrinciple {
  id              String   @id @default(cuid())
  orderIndex      Int      @default(1)
  number          String   @default("01")
  title           String
  description     String
  icon            String   @default("cpu")
  supportingLabel String   @default("Standard:")
  supportingText  String   @default("")
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  role         String
  bio          String   @default("")
  initials     String   @default("DC")
  badge        String   @default("ENGINEERING")
  avatarUrl    String?
  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?
  isFeatured   Boolean  @default(false)
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserInvitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        Role      @default(USER)
  tokenHash   String    @unique
  message     String?
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model SocialConnection {
  id                String         @id @default(cuid())
  platform          SocialPlatform @unique
  accountName       String
  accountId         String
  accountHandle     String?
  avatarUrl         String?
  accessToken       String
  refreshToken      String?
  keyVersion        Int            @default(1)
  tokenExpiresAt    DateTime?
  scopes            String[]       @default([])
  status            String         @default("DISCONNECTED")
  isActive          Boolean        @default(true)
  connectedAt       DateTime?
  connectedById     String?
  lastSyncAt        DateTime?
  lastHealthCheckAt DateTime?
  lastLatencyMs     Int?
  lastError         String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model OAuthState {
  id           String         @id @default(cuid())
  state        String         @unique
  platform     SocialPlatform
  codeVerifier String?
  userId       String
  redirectPath String?
  expiresAt    DateTime
  createdAt    DateTime       @default(now())

  @@index([expiresAt])
}

model WebhookEndpoint {
  id              String            @id @default(cuid())
  name            String
  url             String
  events          String[]          @default([])
  secretEncrypted String
  secretPrefix    String
  keyVersion      Int               @default(1)
  isActive        Boolean           @default(true)
  createdById     String?
  lastDeliveryAt  DateTime?
  lastStatusCode  Int?
  lastError       String?
  deliveries      WebhookDelivery[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([isActive, createdAt])
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventType      String
  payload        Json
  responseStatus Int?
  responseBody   String?
  latencyMs      Int?
  attemptCount   Int             @default(1)
  status         String
  errorMessage   String?
  deliveredAt    DateTime        @default(now())

  @@index([endpointId, deliveredAt])
  @@index([status, deliveredAt])
}

model SocialPost {
  id              String              @id @default(cuid())
  title           String?
  baseContent     String
  platformContent Json?
  variables       Json?
  mediaUrls       String[]
  mediaAssets     SocialMediaAsset[]
  targetPlatforms SocialPlatform[]
  status          PostStatus          @default(DRAFT)
  scheduledFor    DateTime?
  timezone        String?             @default("UTC")
  publishedAt     DateTime?
  cancelledAt     DateTime?
  showcaseId      String?
  deliveryLogs    SocialDeliveryLog[]
  authorId        String
  author          User                @relation(fields: [authorId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, scheduledFor])
}

model SocialMediaAsset {
  id           String      @id @default(cuid())
  postId       String?
  post         SocialPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  uploadedById String
  publicId     String      @unique
  secureUrl    String
  resourceType String
  format       String
  bytes        Int
  width        Int?
  height       Int?
  durationSec  Float?
  fileName     String
  altText      String?
  tags         String[]    @default([])
  folder       String?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([postId, sortOrder])
  @@index([uploadedById, createdAt])
}

model SocialDeliveryLog {
  id             String         @id @default(cuid())
  postId         String
  post           SocialPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  status         String
  externalPostId String?
  externalUrl    String?
  latencyMs      Int?
  attemptCount   Int            @default(1)
  error          Json?
  createdAt      DateTime       @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

model EmailJob {
  id            String         @id @default(cuid())
  template      String
  toEmail       String
  payload       Json
  status        EmailJobStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  @@index([status, nextAttemptAt])
}

model JobRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  detail     Json?

  @@index([name, startedAt])
}

model IdempotencyRecord {
  key       String   @id
  scope     String
  status    Int
  response  Json
  createdAt DateTime @default(now())
}